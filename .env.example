NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Trazas distribuidas OpenTelemetry. Desactivadas por defecto en desarrollo.
# En producción, el backend envía OTLP/HTTP a Grafana Alloy dentro de la VPS;
# no conoce ni almacena credenciales de Grafana Cloud.
OTEL_TRACING_ENABLED=false
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://host.docker.internal:4318/v1/traces
OTEL_SERVICE_NAME=finanzas-backend
OTEL_SERVICE_VERSION=local
OTEL_TRACE_SAMPLE_RATIO=1

# Auth
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Orígenes extra confiables para auth (dev: el frontend en :3001). Separados por coma.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Prod: dominio para Caddy (sin definir = localhost). En el VPS: finanzas.tudominio.com
# DOMAIN=
